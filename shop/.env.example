# Kopieren nach .env und Werte anpassen.

# Postgres-Verbindung (async, asyncpg-Treiber). Wird sowohl von der App
# als auch von Alembic (via run_sync) verwendet.
DATABASE_URL=postgresql+asyncpg://vainea:vainea@localhost:5432/vainea

# Zufälligen Wert erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# SQLAdmin-Session-Cookie-Secret (separat vom App-Secret halten)
ADMIN_SESSION_SECRET=change-me-too

# Mollie (Test-API-Key aus dem Mollie-Dashboard, https://my.mollie.com)
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_URL=https://vainea.de/checkout/webhook

# E-Mail-Versand (Bestellbestätigungen). Lokal reicht ein laufender
# Mailhog/Mailpit-Container (fängt Mails ab, kein echter Versand, kein
# Login/TLS nötig - Web-UI standardmäßig auf http://localhost:8025):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# Für Produktion durch einen echten SMTP-Anbieter ersetzen.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@vainea.de
SMTP_FROM_NAME=VAINEA

ENVIRONMENT=development
