# Kopieren nach .env und Werte anpassen.

# Postgres-Verbindung (async, asyncpg-Treiber). Wird sowohl von der App
# als auch von Alembic (via run_sync) verwendet.
#
# ACHTUNG: Im Docker-Compose-Betrieb wird dieser Wert NICHT verwendet. Dort
# baut docker-compose.yml die URL selbst aus POSTGRES_PASSWORD zusammen und
# zeigt auf den postgres-Service. Diese Zeile gilt nur für den lokalen Start
# ohne Docker. Das Gleiche gilt für ENVIRONMENT weiter unten.
DATABASE_URL=postgresql+asyncpg://vainea:vainea@localhost:5432/vainea

# Zufälligen Wert erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# SQLAdmin-Session-Cookie-Secret (separat vom App-Secret halten)
ADMIN_SESSION_SECRET=change-me-too

# Mollie (Test-API-Key aus dem Mollie-Dashboard, https://my.mollie.com)
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_URL=https://vainea.de/checkout/webhook

# E-Mail-Versand (Bestellbestätigungen). Lokal reicht ein laufender
# Mailhog/Mailpit-Container (fängt Mails ab, kein echter Versand, kein
# Login/TLS nötig - Web-UI standardmäßig auf http://localhost:8025):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# Für Produktion durch einen echten SMTP-Anbieter ersetzen.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@vainea.de
SMTP_FROM_NAME=VAINEA

# Objektspeicher für Produktbilder (Hetzner Object Storage, S3-kompatibel).
# Bucket im Hetzner-Cloud-Console anlegen, auf "öffentlich" stellen und
# Access-Key erzeugen. Leer lassen für lokale Entwicklung - Bilder bleiben
# dann unter app/static/images; für die Produktions-Migration siehe
# scripts/upload_images_to_storage.py.
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=vainea-product-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://vainea-product-images.fsn1.your-objectstorage.com

# Offsite-Backup: eigener, PRIVATER Bucket für die Datenbank-Dumps aus
# scripts/backup.sh. Muss ein anderer sein als S3_BUCKET - der ist absichtlich
# öffentlich lesbar, und ein Dump enthaelt Namen, Adressen und
# Bestellhistorien. scripts/upload_backup.py verweigert sonst den Upload.
# Leer lassen = kein Offsite-Backup (backup.sh weist dann darauf hin).
S3_BACKUP_BUCKET=
# Aufbewahrung der Dumps im Objektspeicher in Tagen.
BACKUP_RETENTION_DAYS=30

ENVIRONMENT=development

# Nur für docker-compose.yml: Passwort für die dort mitlaufende
# Postgres-Instanz (baut daraus selbst die DATABASE_URL für den app-Service).
POSTGRES_PASSWORD=change-me-too-please
